<?xml version="1.0" encoding="utf-8"?>
<!--
  Template de AppxManifest para apps Windows da linha OpS/Elevbit.
  TROQUE os campos marcados com >>> pelos valores do Partner Center
  (Product identity) depois de reservar o nome do app.
  Autor: Joaquim Pedro de Morais Filho - j360074@hotmail.com
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name=">>> Package/Identity/Name do Partner Center <<<"
    Publisher=">>> CN=Publisher do Partner Center <<<"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>JP TERMINAL</DisplayName>
    <PublisherDisplayName>Joaquim Pedro de Morais Filho</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable=">>> SEU_APP.exe <<<"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="JP TERMINAL"
        Description="Terminal leve estilo 1995 com PowerShell real e analise de arquivos."
        BackgroundColor="#050805"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
